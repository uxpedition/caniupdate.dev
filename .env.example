# Server-only, full OpenAI-compatible Chat Completions endpoint (path must end with /chat/completions).
AI_BRIEFING_ENDPOINT=https://opencode.ai/zen/go/v1/chat/completions
AI_BRIEFING_API_KEY=
AI_BRIEFING_MODEL=deepseek-v4-flash
# Optional local libSQL file; defaults to .data/briefings.db and is never synced to Turso Cloud.
# AI_BRIEFING_CACHE_PATH=.data/briefings.db

# Release alternative (replace the three settings above):
# AI_BRIEFING_ENDPOINT=https://openrouter.ai/api/v1/chat/completions
# AI_BRIEFING_API_KEY=
# AI_BRIEFING_MODEL=deepseek/deepseek-v4-flash
