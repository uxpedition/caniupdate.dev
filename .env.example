# Server-only, full OpenAI-compatible Chat Completions endpoint (path must end with /chat/completions).
# Briefing snapshots are stored in the D1 binding BRIEFINGS_DB; there is no cache-path setting.
# Nuxt development reads .env. Wrangler preview reads .output/server/.dev.vars, and a build recreates
# that output directory, so copy the git-ignored file after each build: cp .dev.vars .output/server/.dev.vars
AI_BRIEFING_ENDPOINT=https://opencode.ai/zen/go/v1/chat/completions
AI_BRIEFING_API_KEY=
AI_BRIEFING_MODEL=deepseek-v4-flash

# Evidence provider credentials belong to the private backend, not this Nuxt environment.
# Optional GITHUB_TOKEN goes in workers/evidence/.dev.vars for local dev/preview,
# or a secret on the deployed evidence Worker. Do not copy AI credentials there.

# Release alternative (replace the three settings above):
# AI_BRIEFING_ENDPOINT=https://openrouter.ai/api/v1/chat/completions
# AI_BRIEFING_API_KEY=
# AI_BRIEFING_MODEL=deepseek/deepseek-v4-flash
