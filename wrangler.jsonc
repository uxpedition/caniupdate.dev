{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "can-i-update-local",
  "compatibility_date": "2026-09-16",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": false,
  "durable_objects": {
    "bindings": [
      {
        "name": "PACKAGE_EVIDENCE",
        "class_name": "PackageEvidence",
        "script_name": "can-i-update-local-evidence",
      },
    ],
  },
  // Default environment is local-only: this placeholder must never be deployed.
  "d1_databases": [
    {
      "binding": "BRIEFINGS_DB",
      "database_name": "can-i-update-local-briefings",
      "database_id": "00000000-0000-0000-0000-000000000001",
      "migrations_dir": "migrations",
      "remote": false,
    },
  ],
  "env": {
    "preview": {
      "name": "can-i-update-preview",
      "account_id": "8a0be24aad326a55ba610b94b106be81",
      "workers_dev": true,
      "preview_urls": false,
      "durable_objects": {
        "bindings": [
          {
            "name": "PACKAGE_EVIDENCE",
            "class_name": "PackageEvidence",
            "script_name": "can-i-update-preview-evidence",
          },
        ],
      },
      "d1_databases": [
        {
          "binding": "BRIEFINGS_DB",
          "database_name": "can-i-update-preview-briefings",
          "database_id": "351da802-5296-4e6a-a186-f9d1e99036b6",
          "migrations_dir": "migrations",
        },
      ],
    },
  },
}
