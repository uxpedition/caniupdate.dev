{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "can-i-update-local",
  "compatibility_date": "2026-09-16",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": false,
  "durable_objects": {
    "bindings": [
      {
        "name": "PACKAGE_EVIDENCE",
        "class_name": "PackageEvidence",
        "script_name": "can-i-update-local-evidence",
      },
    ],
  },
  // The default environment is local-only: neither name may be deployed. The briefing Worker owns D1, the provider
  // credential, and the browser-facing socket; this Worker only submits an already-built packet to its private
  // named entrypoint, so no D1 binding and no AI setting belongs here.
  "services": [
    {
      "binding": "BRIEFING_SERVICE",
      "service": "can-i-update-local-briefing",
      "entrypoint": "BriefingSubmitter",
    },
  ],
  "env": {
    "preview": {
      "name": "can-i-update-preview",
      "account_id": "8a0be24aad326a55ba610b94b106be81",
      "workers_dev": true,
      "preview_urls": false,
      // The origin this deployment publishes. The value baked into the prerendered homepage at build time must match;
      // production will carry its own environment with https://caniupdate.dev. Local sessions set neither, so the
      // built Worker keeps the value the build was given.
      "vars": { "NUXT_PUBLIC_SITE_URL": "https://can-i-update-preview.caniupdate-dev.workers.dev" },
      "observability": {
        "enabled": true,
        "head_sampling_rate": 1,
      },
      "durable_objects": {
        "bindings": [
          {
            "name": "PACKAGE_EVIDENCE",
            "class_name": "PackageEvidence",
            "script_name": "can-i-update-preview-evidence",
          },
        ],
      },
      "services": [
        {
          "binding": "BRIEFING_SERVICE",
          "service": "can-i-update-preview-briefing",
          "entrypoint": "BriefingSubmitter",
        },
      ],
    },
  },
}
