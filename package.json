{
  "name": "can-i-update",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "node scripts/check-site-url/check-site-url.ts && nuxt build && wrangler deploy --dry-run --config workers/evidence/wrangler.jsonc --env= && wrangler deploy --dry-run --config workers/briefing/wrangler.jsonc --env=",
    "db:check": "node scripts/sync-migrations/sync-migrations.ts --check && node scripts/bundle-evidence-migrations/bundle-evidence-migrations.ts --check",
    "db:check:evidence": "node scripts/bundle-evidence-migrations/bundle-evidence-migrations.ts --check",
    "db:generate": "drizzle-kit generate && node scripts/sync-migrations/sync-migrations.ts",
    "db:generate:evidence": "drizzle-kit generate --config workers/evidence/drizzle.config.ts && node scripts/bundle-evidence-migrations/bundle-evidence-migrations.ts",
    "db:migrate:local": "node scripts/dev/dev.ts --migrate-only",
    "dev": "node scripts/dev/dev.ts",
    "generate": "nuxt generate",
    "preview": "node scripts/dev/dev.ts --preview",
    "smoke:preview": "node scripts/smoke/smoke.ts --preview",
    "preinstall": "node scripts/check-package-manager/check-package-manager.mjs",
    "prepare": "nuxt prepare && lefthook install",
    "postinstall": "nuxt prepare",
    "commitlint": "commitlint",
    "type-check": "nuxt typecheck && tsc --project workers/evidence/tsconfig.json && tsc --project workers/briefing/tsconfig.json",
    "zed:vue-language-server": "node node_modules/@vue/language-server/bin/vue-language-server.js --stdio",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "oxlint . --fix",
    "lint:check": "oxlint .",
    "format": "oxfmt . .gitlab-ci.yml --write",
    "format:check": "oxfmt . .gitlab-ci.yml --check"
  },
  "dependencies": {
    "@effect/ai-openai-compat": "4.0.0",
    "@grafana/faro-web-sdk": "2.12.1",
    "@lucide/vue": "^1.47.0",
    "@nuxt/fonts": "^0.14.0",
    "@tanstack/vue-query": "^5.102.8",
    "class-variance-authority": "^0.7.1",
    "cn": "^0.4.0",
    "drizzle-orm": "1.0.0-rc.5-ab785fc",
    "effect": "4.0.0",
    "h3": "^2.0.1-rc.32",
    "nuxt": "^4.5.2",
    "reka-ui": "^2.10.4",
    "tar-stream": "^3.2.1",
    "vue": "^3.5.42",
    "vue-router": "^5.3.1"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "5.20260925.1",
    "@commitlint/cli": "^21.2.3",
    "@commitlint/config-conventional": "^21.2.3",
    "@effect/platform-node": "4.0.0",
    "@oxlint/plugins": "1.85.0",
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^26.6.2",
    "@vue/language-server": "3.3.11",
    "@vue/typescript-plugin": "3.3.11",
    "drizzle-kit": "1.0.0-rc.5-ab785fc",
    "lefthook": "^2.1.14",
    "miniflare": "5.20260921.0-alpha",
    "nitropack": "2.13.4",
    "oxfmt": "^0.70.0",
    "oxlint": "1.85.0",
    "oxlint-tsgolint": "^7.0.2001",
    "tailwindcss": "^4.3.3",
    "typescript": "6.0.3",
    "vitest": "^5.0.1",
    "vue-tsc": "3.3.11",
    "wrangler": "4.140.0",
    "zod": "4.4.3"
  },
  "devEngines": {
    "packageManager": {
      "name": "nub",
      "version": "^0.9.6",
      "onFail": "ignore"
    }
  },
  "packageManager": "nub@0.9.6",
  "patchedDependencies": {
    "drizzle-orm@1.0.0-rc.5-ab785fc": "patches/drizzle-orm@1.0.0-rc.5-ab785fc.patch"
  }
}
