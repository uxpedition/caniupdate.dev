{
  "name": "can-i-update",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "nuxt build && wrangler deploy --dry-run --config workers/evidence/wrangler.jsonc --env= && wrangler deploy --dry-run --config workers/briefing/wrangler.jsonc --env=",
    "db:migrate:local": "wrangler d1 migrations apply BRIEFINGS_DB --local --config workers/briefing/wrangler.jsonc --persist-to .wrangler/state",
    "dev": "node scripts/dev.ts",
    "generate": "nuxt generate",
    "preview": "node scripts/dev.ts --preview",
    "preinstall": "node scripts/check-package-manager.mjs",
    "prepare": "nuxt prepare && lefthook install",
    "postinstall": "nuxt prepare",
    "commitlint": "commitlint",
    "type-check": "nuxt typecheck && tsc --project workers/evidence/tsconfig.json && tsc --project workers/briefing/tsconfig.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "oxlint . --fix",
    "lint:check": "oxlint .",
    "format": "oxfmt . --write",
    "format:check": "oxfmt ."
  },
  "dependencies": {
    "@effect/ai-openai-compat": "4.0.0-rc.115",
    "@lucide/vue": "^1.47.0",
    "@nuxt/fonts": "^0.14.0",
    "@tanstack/vue-query": "^5.102.8",
    "class-variance-authority": "^0.7.1",
    "cn": "^0.4.0",
    "effect": "4.0.0-rc.115",
    "h3": "^2.0.1-rc.32",
    "nuxt": "^4.5.2",
    "reka-ui": "^2.10.4",
    "tar-stream": "^3.2.1",
    "vue": "^3.5.42",
    "vue-router": "^5.3.1"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "5.20260925.1",
    "@commitlint/cli": "^21.2.3",
    "@commitlint/config-conventional": "^21.2.3",
    "@effect/platform-node": "4.0.0-rc.115",
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^26.6.2",
    "lefthook": "^2.1.14",
    "miniflare": "5.20260921.0-alpha",
    "oxfmt": "^0.70.0",
    "oxlint": "^1.83.0",
    "oxlint-tsgolint": "^7.0.2001",
    "tailwindcss": "^4.3.3",
    "typescript": "6.0.3",
    "vitest": "^5.0.1",
    "vue-tsc": "^3.3.11",
    "wrangler": "4.140.0"
  },
  "devEngines": {
    "packageManager": {
      "name": "nub",
      "version": "^0.8.3",
      "onFail": "ignore"
    }
  },
  "packageManager": "nub@0.8.3"
}
